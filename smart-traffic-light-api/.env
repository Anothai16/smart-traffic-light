# ----------------------------------------------------
# 1. ROOT PATH: ตำแหน่งโฟลเดอร์หลักที่รวม Lane ทั้งหมด
# ⚠️ แก้ไขให้เป็น Path ในเครื่องของคุณ
IMAGE_ROOT_PATH="C:\TrafficData"

# ----------------------------------------------------
# 2. LANE CONFIGURATION: ชื่อ Lane และชื่อ Subfolder ภายใน ROOT PATH
# รูปแบบ: LANE_<ชื่อเรียก>="<ชื่อโฟลเดอร์จริง>"
# ชื่อเรียก: ใช้ในโค้ด (เช่น 'Lane 1 (PC-A)')
# ชื่อโฟลเดอร์จริง: ชื่อโฟลเดอร์ย่อยใน C:\TrafficData (เช่น 'Lane 1 (PC-A)')

LANE_1_NAME="Lane 1 (PC-A)"
LANE_1_FOLDER="Lane1"

LANE_2_NAME="Lane 2 (PC-B)"
LANE_2_FOLDER="Lane2"

LANE_3_NAME="Lane 3 (PC-C)"
LANE_3_FOLDER="Lane3"

LANE_4_NAME="Lane 4 (PC-D)"
LANE_4_FOLDER="Lane4"

# ----------------------------------------------------
# 3. STATIC URL CONFIG: สำหรับ Static Plugin ใน Elysia/Server
# ต้องตรงกับ PREFIX ที่ตั้งค่าไว้ใน server.ts
STATIC_PREFIX="/static/traffic-images"
# URL ฐานของ Backend (สำหรับสร้าง URL รูปภาพ)
BACKEND_BASE_URL="http://localhost:8091" 