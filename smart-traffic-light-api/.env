# ----------------------------------------------------
# 2. LANE CONFIGURATION:
# LANE_X_NAME = "ชื่อที่จะโชว์ใน Frontend"
# LANE_X_FOLDER = "ชื่อโฟลเดอร์จริงที่ถูกสร้าง (ต้องตรงกับ lane_id ที่ Python ส่งมา)"

# ตัวอย่าง: ถ้า Python ส่ง lane_id="Lane_W" โฟลเดอร์จะเป็น Lane_W
# ดังนั้นในนี้ควรตั้ง LANE_1_FOLDER="Lane_W" ให้ตรงกัน

